{
  "name": "visualize",
  "version": "1.0.0",
  "description": "An engine for model-driven, step-through visual explanations: isometric stages, linked math panels, and checks that the picture matches the model.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test \"src/**/*.test.ts\" \"src/**/*.test.mjs\" \"examples/**/*.test.ts\" \"examples/**/*.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "verify": "node scripts/verify.mjs",
    "shoot": "node scripts/shoot.mjs",
    "verify:controls": "node scripts/verify.mjs --controls --quick",
    "export:svg": "node scripts/export-svg.mjs",
    "check:embed": "node scripts/check-embed.mjs",
    "new-scene": "node scripts/new-scene.mjs",
    "check:reproducible": "node scripts/check-reproducible.mjs",
    "check:drawing": "node examples/escalator/build.mjs && node scripts/check-drawing.mjs dist/escalator.html && node examples/lock/build.mjs && node scripts/check-drawing.mjs dist/lock.html"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.169.0",
    "esbuild": "^0.28.2",
    "kokoro-js": "1.2.1",
    "puppeteer-core": "^25.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "katex": "^0.19.1",
    "three": "0.169.0"
  }
}
