#!/usr/bin/env node
// __TITLE__: the page (mode: __MODE__). Made by scripts/new-figure.mjs --kind object as a working
// everyday-object starter; replace model.mjs first, then figure.mjs and story.mjs (references/objects.md).
//
//   node build.mjs [--out <page.html>]     then: node <skill>/scripts/check-drawing.mjs <page.html>

import { createRequire } from "node:module";
import { existsSync, mkdirSync, readFileSync, writeFileSync } from "node:fs";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";
import { MODELS, VARIANTS } from "./model.mjs";
import { STEPS, PRED_STEP, STAGE, headings, captions, CLAIMS, COVERAGE } from "./story.mjs";
import { drawingPage, esc } from "__ROOT__/src/drawing/page.mjs";
import { distributeCallouts, spread } from "__ROOT__/src/rig/index.ts";

const { buildSync } = createRequire(new URL("__ROOT__/package.json", import.meta.url))("esbuild");
const HERE = dirname(fileURLToPath(import.meta.url));
const outArg = process.argv.indexOf("--out");
const out = outArg > 0 ? process.argv[outArg + 1] : join(HERE, "dist", "__NAME__.html");

// Stage layout via the canonical "cutaway-vessel" spread (guaranteed zero-overlap zones & rails)
const S = spread("cutaway-vessel");
const VOICE = existsSync(join(HERE, "voice.json")) ? JSON.parse(readFileSync(join(HERE, "voice.json"), "utf8")) : null;

// Opening anatomy callouts placed cleanly along the spread's left rail (never clipped by heading/HUD)
const LABELS = distributeCallouts(S, [
  { id: "nozzle", text: "Plunger", to: "nozzle", side: "left", beats: [0, 1] },
  { id: "tube", text: "Dip tube", to: "tube", side: "left", beats: [0, 1] },
  { id: "liquid", text: "Liquid", to: "liquid", side: "left", beats: [0, 1] },
]);
const labelSvg = (l) =>
  `<g class="label" data-label="${l.id}" data-beats="${l.beats.join(" ")}" data-at="${l.to}" data-to="${l.at[0]},${l.at[1]}"><path class="leader"/><circle class="ldot" r="26"/><text x="${l.at[0]}" y="${l.at[1]}" text-anchor="${l.anchor}">${esc(l.text)}</text></g>`;
const skeleton = () =>
  `<defs id="rigDefs"></defs><g id="scene" data-camera=""></g><g id="explainer" data-camera-avoid=""></g><g id="labels">${LABELS.map(labelSvg).join("")}</g>`;

function variantData(name) {
  const M = MODELS[name];
  return {
    name,
    label: VARIANTS[name].label,
    svg: skeleton(),
    heads: headings(M),
    captions: captions(M),
    voice: VOICE?.variants?.[name] ?? null,
  };
}
const VARIANT_DATA = Object.fromEntries(Object.keys(VARIANTS).map((n) => [n, variantData(n)]));

// ---------------------------------------------------------------- machine hooks (serialized into page)
function machine(DATA) {
  const $ = (id) => document.getElementById(id);
  const root = $("vz");
  const clamp = (u) => Math.max(0, Math.min(1, u));
  let V = null, model = null, cur = null, F = null, stage = null, lastAt = null, lastHud = "";
  let lastFocus = { focus: null, lit: [] };

  const anim = (k) => (V.voice?.[k] ? Math.max(2, 0.8 * V.voice[k].duration) : 0.75 * DATA.plain);
  const at = (k, t, still, SEG) => {
    const tt = still ? anim(k) : Math.max(0, t - SEG.lead);
    const u = clamp(tt / anim(k));
    const st = cycleState(model.v, DATA.stages[k] ?? "rest", u, 0);
    return { ...st, k };
  };
  const stillAt = (k, SEG) => SEG.lead + anim(k);

  function mount(v, m) {
    V = v;
    model = m;
    F = FIG.figure(model, FIG.cameraFor(model, DATA.box));
    $("scene").replaceChildren();
    lastHud = "";
    stage = new FIG.RigStage($("scene"));
    for (const p of F.parts) stage.add(p.id, p.part, p.svg);
  }

  function render(state) {
    cur = state;
    const o = F.pose(state);
    stage.apply(o.items);
    lastAt = o.at;
    const hud = $("explainer");
    if (hud && o.explainer !== lastHud) {
      hud.innerHTML = o.explainer;
      lastHud = o.explainer;
    }
    focusParts();
    $("r-left").textContent = `${state.remainingMl.toFixed(1)} mL`;
    $("r-sprays").textContent = String(state.spraysLeft);
    $("r-pressure").textContent = state.pressureLabel;
  }

  function focusParts() {
    const { focus, lit } = lastFocus, lab = root.hasAttribute("data-lab");
    stage?.focus((part) => ({
      recede: lit.length ? !lit.includes(part) : !lab && focus ? !focus.includes(part) : false,
      named: lit.includes(part),
    }));
  }
  const focus = (f) => ((lastFocus = f), focusParts());

  function boundsOf(names) {
    const scene = $("scene");
    if (!scene) return null;
    const inv = scene.getCTM().inverse();
    let b = null;
    const add = (x0, y0, x1, y1) =>
      (b = b
        ? { x0: Math.min(b.x0, x0), y0: Math.min(b.y0, y0), x1: Math.max(b.x1, x1), y1: Math.max(b.y1, y1) }
        : { x0, y0, x1, y1 });
    for (const n of names) {
      for (const el of scene.querySelectorAll(`[data-part="${n}"]`)) {
        if (el.style.display === "none") continue;
        const r = el.getBBox();
        if (!r.width && !r.height) continue;
        const m = inv.multiply(el.getCTM());
        const pts = [
          [r.x, r.y],
          [r.x + r.width, r.y],
          [r.x, r.y + r.height],
          [r.x + r.width, r.y + r.height],
        ].map(([x, y]) => [m.a * x + m.c * y + m.e, m.b * x + m.d * y + m.f]);
        add(
          Math.min(...pts.map((q) => q[0])),
          Math.min(...pts.map((q) => q[1])),
          Math.max(...pts.map((q) => q[0])),
          Math.max(...pts.map((q) => q[1])),
        );
      }
    }
    return b;
  }

  // Interactive Lab: choose how many times to press the pump and watch the bottle level update
  function lab(values) {
    const presses = Math.max(1, Math.min(model.totalSprays, Math.round(Number(values.sprays ?? 10))));
    const res = pumpAfter(model.v, presses);
    const st = cycleState(model.v, "spray", 1, Math.max(0, presses - 1));
    const verdict =
      res.spraysLeft === 0
        ? `Empty after ${res.strokes} presses: all ${model.v.bottleMl} mL have been sprayed.`
        : `After ${res.strokes} ${res.strokes === 1 ? "press" : "presses"}, ${res.remainingMl.toFixed(1)} mL remains (${res.spraysLeft} sprays left).`;
    return {
      ok: true,
      verdict,
      rows: [
        `Liquid sprayed: ${res.dispensedMl.toFixed(1)} mL (${res.strokes} × ${model.v.doseMl.toFixed(1)} mL).`,
        `Liquid left: ${res.remainingMl.toFixed(1)} mL of ${model.v.bottleMl} mL.`,
        `Sprays remaining: ${res.spraysLeft} of ${res.totalSprays}.`,
      ],
      state: { ...st, ...res, lab: true },
    };
  }

  // Now you try: practice questions generated live from the model
  function question(n, r) {
    const m = model, v = m.v, kind = n % 3;
    if (kind === 0) {
      const count = [5, 10, 15, 20, 25][Math.floor(r() * 5)];
      const res = pumpAfter(v, count);
      const wrong1 = +(Math.max(0, res.remainingMl - v.doseMl * 5)).toFixed(1);
      const wrong2 = +(res.remainingMl + v.doseMl * 5).toFixed(1);
      return {
        q: `This ${v.bottleMl} mL bottle sprays ${v.doseMl.toFixed(1)} mL per press. How much liquid is left after ${count} presses?`,
        choices: [`${res.remainingMl.toFixed(1)} mL`, `${wrong1.toFixed(1)} mL`, `${wrong2.toFixed(1)} mL`],
        explain: `${count} × ${v.doseMl.toFixed(1)} = ${res.dispensedMl.toFixed(1)} mL sprayed, leaving ${v.bottleMl} - ${res.dispensedMl.toFixed(1)} = ${res.remainingMl.toFixed(1)} mL.`,
      };
    }
    if (kind === 1) {
      const right = m.totalSprays;
      return {
        q: `A full ${v.bottleMl} mL bottle delivers ${v.doseMl.toFixed(1)} mL each time you press. About how many full sprays can it give?`,
        choices: [String(right), String(Math.round(right / 2)), String(right * 2)],
        explain: `${v.bottleMl} / ${v.doseMl.toFixed(1)} = ${right} sprays in a full bottle.`,
      };
    }
    return {
      q: "When you let go of the plunger, what pushes fresh liquid up the dip tube into the chamber?",
      choices: [
        "Outside air pressing on the liquid as chamber pressure drops",
        "Gravity pulling the liquid straight up the straw",
        "High pressure trapped above the top nozzle",
      ],
      explain: "The return spring lifts the plunger and creates low pressure in the chamber, so room air pressing on the bottle liquid pushes a fresh dose up the dip tube.",
    };
  }

  return {
    model: (v) => MODELS_IN_PAGE[v.name],
    mount,
    at,
    stillAt,
    render,
    focus,
    anchors: () => lastAt,
    lab,
    question,
    boundsOf,
    clearArea: () => DATA.camera.clear,
    heading: (k) => V.heads[k] ?? null,
    info: () => (cur ? { stage: cur.stage, strokes: cur.strokes, remainingMl: cur.remainingMl } : {}),
  };
}

// ---------------------------------------------------------------- build page
const bundle = buildSync({
  entryPoints: [join(HERE, "figure.mjs")],
  bundle: true,
  format: "iife",
  globalName: "FIG",
  write: false,
  minify: true,
  legalComments: "none",
}).outputFiles[0].text;
if (/<\/script/i.test(bundle)) throw new Error("the figure bundle contains </script");
const modelSrc = readFileSync(join(HERE, "model.mjs"), "utf8").replace(/^export /gm, "") + "\nconst MODELS_IN_PAGE = MODELS;\n";
const BASE = Object.keys(VARIANTS)[0], M0 = MODELS[BASE], std = VARIANT_DATA[BASE];

const DATA = {
  box: S.box,
  plain: 7,
  stages: STAGE,
  base: BASE,
  steps: STEPS.map((s, k) => ({ heading: headings(M0)[k], focus: s.focus, ...(s.shot ? { shot: s.shot } : {}) })),
  camera: {
    clear: S.clear,
    items: {},
    alias: {},
    around: {},
    subject: Object.fromEntries(STEPS.flatMap((s, k) => (s.subject ? [[k, s.subject]] : []))),
  },
  alias: {},
  predict: {
    step: PRED_STEP,
    question: "You press the orange plunger down and squeeze the trapped dose. What happens next?",
    choices: [
      "The bottom valve shuts, pressure climbs, and liquid sprays out the nozzle",
      "The liquid gets pushed straight back down the dip tube into the bottle",
      "Nothing sprays until you turn the bottle upside down",
    ],
    answer: 0,
    explanation: Object.fromEntries(
      Object.entries(MODELS).map(([k, m]) => [
        k,
        `With the bottom valve sealed, pressure climbs to ${m.v.openPressure} times room air, opening the top valve to spray ${m.v.doseMl.toFixed(1)} mL of mist.`,
      ]),
    ),
    locked: "Locked in. Press play to see the spray.",
  },
  lab: {
    button: "Try pumping",
    title: "Pump the bottle",
    heading: "Watch the bottle level drop",
    intro: "Slide to choose how many times you press the pump.",
    inputs: [{ id: "sprays", label: "Presses", min: 1, max: 50, step: 1, value: 10 }],
  },
  variants: VARIANT_DATA,
};

const CSS = `
${readFileSync(new URL("__ROOT__/src/rig/rig.css", import.meta.url), "utf8")}
${S.css}
`;

const HTML = drawingPage({
  title: "__TITLE__",
  about: "Pressing seals the bottom valve and fires mist; letting go pulls a fresh dose up the straw.",
  scene: "__NAME__",
  steps: STEPS,
  stageLabel: "__TITLE__, drawn as a cutaway 3D object with a live explainer card. Left and right arrows step through; space plays and pauses.",
  viewBox: S.viewBox.str,
  figLabel: "Cutaway glass pump bottle with amber liquid, dip tube, orange plunger nozzle, mist spray, and a side explainer card",
  concept: std.voice ? std.voice[0].text : std.captions[0],
  setup: std.captions[0],
  whatIf: { label: "Bottle", variants: Object.entries(VARIANTS).map(([k, v]) => [k, v.label]) },
  totals: `            <span><b id="r-left">${M0.v.bottleMl.toFixed(1)} mL</b> remaining</span>
            <span><b id="r-sprays">${M0.totalSprays}</b> sprays left</span>
            <span><b id="r-pressure">1.0× air</b> chamber</span>`,
  readoutNote: "Readouts and the side explainer card come directly from the bottle model",
  legend: [
    ["var(--orange)", "The pressable plunger head and active spray pressure"],
    ["var(--rig-liquid-dark)", "Liquid reservoir inside the cutaway glass bottle"],
  ],
  facts: [
    "Every press dispenses one fixed chamber dose and conserves total bottle volume. Not drawn in detail: the tiny swirl chamber geometry inside the nozzle tip.",
  ],
  css: CSS,
  modelSrc,
  scripts: bundle,
  machine,
  audit: {
    models: Object.values(MODELS),
    claims: CLAIMS,
    coverage: COVERAGE,
    reviewFile: join(HERE, "review.json"),
    report: out.replace(/\.html$/, ".audit.json"),
  },
  data: DATA,
});

mkdirSync(dirname(out), { recursive: true });
writeFileSync(out, HTML);
console.log(`wrote ${out} (${(HTML.length / 1024 / 1024).toFixed(2)} MB)`);
